index d59f1782f..bd8570f2d 100644
--- a/Source/Windows/Common/FEXUnixLib.cpp
+++ b/Source/Windows/Common/FEXUnixLib.cpp
@@ -10,6 +10,7 @@
 #include <libloaderapi.h>
 #include "Allocator.h"
 #include "FEXUnixLib.h"
+#include <FEXCore/Utils/TypeDefines.h>
 #include "Priv.h"
 
 #define PR_SET_VMA 0x53564d41
@@ -127,6 +128,15 @@ bool SetKernelUnalignedAtomicControl(uint64_t Flags) {
   return Call(FEXUnixLibFunctions::SetKernelUnalignedAtomicControl, &Args) == STATUS_SUCCESS;
 }
 
+uint64_t GetHostPageSize() {
+  FEXUnixLib_GetHostPageSize Args {};
+  if (!Available() || Call(FEXUnixLibFunctions::GetHostPageSize, &Args) != STATUS_SUCCESS || Args.Size < FEXCore::Utils::FEX_PAGE_SIZE ||
+      (Args.Size & (Args.Size - 1))) {
+    return FEXCore::Utils::FEX_PAGE_SIZE;
+  }
+  return Args.Size;
+}
+
 void JITWriteProtect(bool Protect) {
   FEXUnixLib_JITWriteProtect Args {
     .Protect = Protect,
diff --git a/Source/Windows/Common/FEXUnixLib.h b/Source/Windows/Common/FEXUnixLib.h
index 8a2b2faf6..3b058a668 100644
--- a/Source/Windows/Common/FEXUnixLib.h
+++ b/Source/Windows/Common/FEXUnixLib.h
@@ -56,6 +56,13 @@ void DeleteSHMStatsFile();
 
 void* MapFile(HANDLE FileHandle, uint64_t MapSize);
 
+/**
+ * @brief The host's page size, which can be larger than Windows' 4K (16K on Apple silicon).
+ *
+ * @return the host page size, or FEX_PAGE_SIZE when it can't be asked.
+ */
+uint64_t GetHostPageSize();
+
 // Returns the process pid when unixlib is available.
 // Or returns the process ID otherwise.
