From e860944702a9f21abae4833bc2affc9eaf4c70a0 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ond=C5=99ej=20=C5=A0imon?= <ondrej@dorhawk.software>
Date: Tue, 17 Nov 2026 17:38:21 +0100
Subject: [PATCH] winemac.drv: Bracket a window tool's restore with
 WM_ENTERSIZEMOVE and WM_EXITSIZEMOVE.

From Codex's review of Broyojo/hadron#182. When a window tool's frame
leaves a maximized window not filling a display, it is restored once
the frame settles, outside the tool's own size/move pairs, so a
program that saves its placement or commits a resized surface on
WM_EXITSIZEMOVE missed the restore. It now comes between the pair, as
on Windows when a maximized window is dragged or snapped. Measured with
own-frame standard hold-maximized and a tool's left half at 192 DPI:
the tool's pair, then the restore's pair; the frame is unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 dlls/winemac.drv/window.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/dlls/winemac.drv/window.c b/dlls/winemac.drv/window.c
index 1e7939d739..9cfe104b55 100644
--- a/dlls/winemac.drv/window.c
+++ b/dlls/winemac.drv/window.c
@@ -2015,6 +2015,10 @@ void macdrv_window_frame_settled(HWND hwnd)
         TRACE("%p no longer fills a display: it restores to %s\n", hwnd, wine_dbgstr_rect(&window));
         NtUserSetRawWindowPos(hwnd, window, 0, TRUE);
         NtUserSetThreadDpiAwarenessContext(context);
+        /* The restore is part of the tool's move or size, as on Windows when a maximized window is
+         * dragged or snapped: it comes between WM_ENTERSIZEMOVE and WM_EXITSIZEMOVE, so a program
+         * that saves its placement at the end of one hears it. */
+        send_message(hwnd, WM_ENTERSIZEMOVE, 0, 0);
         /* restored now, not when a posted command arrives, to place it below */
         if (!(NtUserGetWindowLongW(hwnd, GWL_STYLE) & WS_DISABLED))
             send_message(hwnd, WM_SYSCOMMAND, SC_RESTORE, 0);
@@ -2034,6 +2038,7 @@ void macdrv_window_frame_settled(HWND hwnd)
                 NtUserSetRawWindowPos(hwnd, again, SWP_NOACTIVATE | SWP_NOZORDER, FALSE);
             }
         }
+        send_message(hwnd, WM_EXITSIZEMOVE, 0, 0);
         return;
     }
     if (!same_display)
