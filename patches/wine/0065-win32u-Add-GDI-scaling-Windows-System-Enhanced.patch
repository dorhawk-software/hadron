+/***********************************************************************
+ *           dc_scale_region
+ *
+ * GDI scaling: a new region with a scaled DC's region in the display's pixels (to_device)
+ * or in the program's own device coordinates.
+ */
+HRGN dc_scale_region( const DC *dc, HRGN hrgn, BOOL to_device )
+{
+    if (to_device) return map_dpi_region( hrgn, dc->scale_from, dc->scale_to );
+    return map_dpi_region( hrgn, dc->scale_to, dc->scale_from );
+}
+
 /***********************************************************************
  *           update_dc_clipping
  *
@@ -181,10 +193,19 @@ INT WINAPI NtGdiExtSelectClipRgn( HDC hdc, HRGN rgn, INT mode )
                 release_dc_ptr( dc );
                 return ERROR;
             }
-            mirror_region( mirrored, rgn, dc->attr->vis_rect.right - dc->attr->vis_rect.left );
+            mirror_region( mirrored, rgn, dc_is_scaled( dc ) ?
+                           GDI_ROUND( (dc->attr->vis_rect.right - dc->attr->vis_rect.left) / dc_scale( dc ) ) :
+                           dc->attr->vis_rect.right - dc->attr->vis_rect.left );
             rgn = mirrored;
         }
 
+        if (dc_is_scaled( dc ))
+        {
+            HRGN scaled = dc_scale_region( dc, rgn, TRUE );
+            if (mirrored) NtGdiDeleteObjectApp( mirrored );
+            rgn = mirrored = scaled;
+        }
+
         if (!dc->hClipRgn)
             create_default_clip_region( dc );
 
@@ -206,6 +227,21 @@ INT WINAPI NtGdiExtSelectClipRgn( HDC hdc, HRGN rgn, INT mode )
 void set_visible_region( HDC hdc, HRGN hrgn, const RECT *vis_rect, const RECT *device_rect,
                          struct window_surface *surface )
 {
+    static const struct ratio none;
+    set_visible_region_scaled( hdc, hrgn, vis_rect, device_rect, surface, none, none );
+}
+
+/***********************************************************************
+ *           set_visible_region_scaled
+ *
+ * GDI scaling: with a DPI in from, the DC draws into a surface in pixels of the DPI in to,
+ * while the program keeps its own coordinates. The visible rect keeps its origin on the
+ * screen (GetDCOrgEx) and takes its size in the surface's pixels.
+ */
+void set_visible_region_scaled( HDC hdc, HRGN hrgn, const RECT *vis_rect, const RECT *device_rect,
+                                struct window_surface *surface, struct ratio from, struct ratio to )
+{
+    RECT vis = *vis_rect, device = *device_rect;
     DC * dc;
 
     if (!(dc = get_dc_ptr( hdc ))) return;
@@ -216,10 +252,32 @@ void set_visible_region( HDC hdc, HRGN hrgn, const RECT *vis_rect, const RECT *d
     /* map region to DC coordinates */
     NtGdiOffsetRgn( hrgn, -vis_rect->left, -vis_rect->top );
 
+    if (from.num)
+    {
+        RECT size = {0, 0, vis.right - vis.left, vis.bottom - vis.top};
+        RECT offset = {device.left - vis.left, device.top - vis.top,
+                       device.right - vis.left, device.bottom - vis.top};
+        HRGN scaled;
+
+        size = map_dpi_rect( size, from, to );
+        offset = map_dpi_rect( offset, from, to );
+        vis.right = vis.left + size.right;
+        vis.bottom = vis.top + size.bottom;
+        SetRect( &device, vis.left + offset.left, vis.top + offset.top,
+                 vis.left + offset.right, vis.top + offset.bottom );
+        if (hrgn && (scaled = map_dpi_region( hrgn, from, to )))
+        {
+            NtGdiDeleteObjectApp( hrgn );
+            hrgn = scaled;
+        }
+    }
+
     if (dc->hVisRgn) NtGdiDeleteObjectApp( dc->hVisRgn );
     dc->dirty = 0;
-    dc->attr->vis_rect = *vis_rect;
-    dc->device_rect = *device_rect;
+    dc->attr->vis_rect = vis;
+    dc->device_rect = device;
+    dc->scale_from = from;
+    dc->scale_to = to;
     dc->hVisRgn = hrgn;
     dibdrv_set_window_surface( dc, surface );
     DC_UpdateXforms( dc );
@@ -244,6 +302,11 @@ INT WINAPI NtGdiOffsetClipRgn( HDC hdc, INT x, INT y )
         x = muldiv( x, dc->attr->vport_ext.cx, dc->attr->wnd_ext.cx );
         y = muldiv( y, dc->attr->vport_ext.cy, dc->attr->wnd_ext.cy );
         if (dc->attr->layout & LAYOUT_RTL) x = -x;
+        if (dc_is_scaled( dc ))
+        {
+            x = GDI_ROUND( x * dc_scale( dc ) );
+            y = GDI_ROUND( y * dc_scale( dc ) );
+        }
         ret = NtGdiOffsetRgn( dc->hClipRgn, x, y );
         update_dc_clipping( dc );
     }
@@ -438,6 +501,12 @@ INT WINAPI NtGdiGetRandomRgn( HDC hDC, HRGN hRgn, INT iCode )
         if (dc->hVisRgn)
         {
             NtGdiCombineRgn( hRgn, dc->hVisRgn, 0, RGN_COPY );
+            if (dc_is_scaled( dc ))
+            {
+                HRGN unscaled = dc_scale_region( dc, hRgn, FALSE );
+                NtGdiCombineRgn( hRgn, unscaled, 0, RGN_COPY );
+                NtGdiDeleteObjectApp( unscaled );
+            }
             /* On Windows NT/2000, the SYSRGN returned is in screen coordinates */
             if (RtlGetCurrentPeb()->OSPlatformId != VER_PLATFORM_WIN32s)
                 NtGdiOffsetRgn( hRgn, dc->attr->vis_rect.left, dc->attr->vis_rect.top );
@@ -458,6 +527,13 @@ INT WINAPI NtGdiGetRandomRgn( HDC hDC, HRGN hRgn, INT iCode )
     if (ret > 0 && (iCode & NTGDI_RGN_MIRROR_RTL) && (dc->attr->layout & LAYOUT_RTL))
         mirror_region( hRgn, hRgn, dc->attr->vis_rect.right - dc->attr->vis_rect.left );
 
+    if (ret > 0 && dc_is_scaled( dc ) && (iCode & ~(NTGDI_RGN_MIRROR_RTL | NTGDI_RGN_MONITOR_DPI)) != SYSRGN)
+    {
+        HRGN unscaled = dc_scale_region( dc, hRgn, FALSE );
+        NtGdiCombineRgn( hRgn, unscaled, 0, RGN_COPY );
+        NtGdiDeleteObjectApp( unscaled );
+    }
+
     release_dc_ptr( dc );
 
     if (ret > 0 && (iCode & NTGDI_RGN_MONITOR_DPI))
diff --git a/dlls/win32u/dc.c b/dlls/win32u/dc.c
index a866869482..c06f79eb07 100644
--- a/dlls/win32u/dc.c
+++ b/dlls/win32u/dc.c
@@ -148,6 +148,30 @@ static void free_dc_attr( DC_ATTR *dc_attr )
 }
 
 
+/***********************************************************************
+ *           apply_device_scale
+ *
+ * GDI scaling: a scaled window DC draws in its display's pixels. Its world-to-device
+ * transform ends with the scale, so everything drawn, fonts too, is drawn at the display's
+ * DPI; what the program reads back is taken out of it again (see NtGdiTransformPoints).
+ */
+static BOOL DC_InvertXform( const XFORM *xformSrc, XFORM *xformDest );
+
+static void apply_device_scale( DC *dc )
+{
+    double scale;
+
+    if (!dc_is_scaled( dc )) return;
+    scale = dc_scale( dc );
+    dc->xformWorld2Vport.eM11 *= scale;
+    dc->xformWorld2Vport.eM12 *= scale;
+    dc->xformWorld2Vport.eM21 *= scale;
+    dc->xformWorld2Vport.eM22 *= scale;
+    dc->xformWorld2Vport.eDx  *= scale;
+    dc->xformWorld2Vport.eDy  *= scale;
+    dc->vport2WorldValid = DC_InvertXform( &dc->xformWorld2Vport, &dc->xformVport2World );
+}
+
 /***********************************************************************
  *           set_initial_dc_state
  */
@@ -194,6 +218,7 @@ static void set_initial_dc_state( DC *dc )
     dc->xformWorld2Vport    = dc->xformWorld2Wnd;
     dc->xformVport2World    = dc->xformWorld2Wnd;
     dc->vport2WorldValid    = TRUE;
+    apply_device_scale( dc );
 
     reset_bounds( &dc->bounds );
 }
@@ -465,6 +490,7 @@ void DC_UpdateXforms( DC *dc )
     /* Create inverse of world-to-viewport transformation */
     dc->vport2WorldValid = DC_InvertXform( &dc->xformWorld2Vport,
         &dc->xformVport2World );
+    apply_device_scale( dc );
 
     /* Reselect the font and pen back into the dc so that the size
        gets updated. */
@@ -1208,10 +1234,21 @@ BOOL WINAPI NtGdiGetTransform( HDC hdc, DWORD which, XFORM *xform )
 
     case 0x204:
         *xform = dc->xformWorld2Vport;
+        if (dc_is_scaled( dc ))
+        {
+            double scale = dc_scale( dc );
+            xform->eM11 /= scale; xform->eM12 /= scale; xform->eM21 /= scale;
+            xform->eM22 /= scale; xform->eDx /= scale; xform->eDy /= scale;
+        }
         break;
 
     case 0x402:
         *xform = dc->xformVport2World;
+        if (dc_is_scaled( dc ))
+        {
+            double scale = dc_scale( dc );
+            xform->eM11 *= scale; xform->eM12 *= scale; xform->eM21 *= scale; xform->eM22 *= scale;
+        }
         break;
 
     default:
diff --git a/dlls/win32u/dce.c b/dlls/win32u/dce.c
index 67d3dc84bc..d6d75d0ccc 100644
--- a/dlls/win32u/dce.c
+++ b/dlls/win32u/dce.c
@@ -148,6 +148,7 @@ struct scaled_surface
     struct window_surface *target_surface;
     struct ratio dpi_from;
     struct ratio dpi_to;
+    BOOL gdi_scaled;    /* GDI scaling: DCs draw into the target surface at its DPI */
 };
 
 static struct scaled_surface *get_scaled_surface( struct window_surface *window_surface )
@@ -254,6 +255,7 @@ static struct window_surface *scaled_surface_create( HWND hwnd, const RECT *surf
     {
         surface = get_scaled_surface( window_surface );
         surface->dpi_from = dpi_from;
+        surface->gdi_scaled = gdi_scaling && !(NtUserGetWindowLongW( hwnd, GWL_EXSTYLE ) & WS_EX_LAYERED);
         scaled_surface_set_target( surface, target_surface, dpi_to );
     }
 
@@ -613,6 +615,24 @@ void window_surface_unlock( struct window_surface *surface )
     pthread_mutex_unlock( &surface->mutex );
 }
 
+/* GDI scaling: the window's DCs draw into the target surface, which is the one to flush */
+static struct window_surface *get_gdi_scaled_target( struct window_surface *surface, struct ratio *from, struct ratio *to )
+{
+    struct scaled_surface *scaled;
+
+    if (!surface || surface == &dummy_surface || surface->funcs != &scaled_surface_funcs) return NULL;
+    scaled = get_scaled_surface( surface );
+    if (!scaled->gdi_scaled) return NULL;
+    if (from) *from = scaled->dpi_from;
+    if (to) *to = scaled->dpi_to;
+    return scaled->target_surface;
+}
+
+BOOL is_gdi_scaled_surface( struct window_surface *surface )
+{
+    return get_gdi_scaled_target( surface, NULL, NULL ) != NULL;
+}
+
 void window_surface_flush( struct window_surface *surface )
 {
     char color_buf[FIELD_OFFSET( BITMAPINFO, bmiColors[256] )];
@@ -621,6 +641,31 @@ void window_surface_flush( struct window_surface *surface )
     BITMAPINFO *shape_info = (BITMAPINFO *)shape_buf;
     RECT dirty = surface->rect, bounds;
     void *color_bits;
+    struct window_surface *target;
+    struct ratio from, to;
+
