From 79b0c7c2d301c5ed114257da02f8bc466523b031 Mon Sep 17 00:00:00 2001
From: Ondrej Simon <ondrej@dorhawk.software>
Date: Sun, 15 Nov 2026 13:28:19 +0100
Subject: [PATCH] win32u: Follow the sideways wheel across threads and nested
 sends.

The fallback to Shift and the wheel kept its state per thread, so it
lost track of the sideways wheel when a child window's parent belongs to
another thread, and when an app sent another sideways wheel while it
handled one. Each pass up to a parent is now noted in a list for the
process, which the window it reaches marks when nothing took it there.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 dlls/win32u/defwnd.c         | 67 +++++++++++++++++++++++++++---------
 dlls/win32u/ntuser_private.h |  2 --
 2 files changed, 50 insertions(+), 19 deletions(-)

diff --git a/dlls/win32u/defwnd.c b/dlls/win32u/defwnd.c
index 066f071b80..19d3a3e4f7 100644
--- a/dlls/win32u/defwnd.c
+++ b/dlls/win32u/defwnd.c
@@ -2405,31 +2405,64 @@ static LRESULT handle_nc_mouse_leave( HWND hwnd )
  * in them. Most of them scroll sideways with Shift and the wheel instead. So when no window from
  * the one that got the sideways wheel up to its top-level window took it, give that window Shift
  * and the wheel, turned the other way (wheel up is left, sideways wheel up is right). An app that
- * handles the sideways wheel anywhere in the chain never sees the difference. */
+ * handles the sideways wheel anywhere in the chain never sees the difference.
+ *
+ * A window passes the sideways wheel up to its parent, which may belong to another thread, and an
+ * app may send another sideways wheel while it handles one. So each pass up the chain is noted in
+ * a list for the whole process, and the window it reaches marks it when nothing took it there. */
+struct hwheel_pass
+{
+    struct hwheel_pass *next;
+    HWND                to;
+    WPARAM              wparam;
+    LPARAM              lparam;
+    BOOL                unhandled;  /* no window from the parent up took it */
+};
+
+static struct hwheel_pass *hwheel_passes;
+static pthread_mutex_t hwheel_lock = PTHREAD_MUTEX_INITIALIZER;
+
+/* the window got the sideways wheel from its child, and nothing from it up took it */
+static BOOL hwheel_passed_on_unhandled( HWND hwnd, WPARAM wparam, LPARAM lparam )
+{
+    struct hwheel_pass *pass;
+
+    pthread_mutex_lock( &hwheel_lock );
+    for (pass = hwheel_passes; pass; pass = pass->next)
+        if (pass->to == hwnd && pass->wparam == wparam && pass->lparam == lparam && !pass->unhandled) break;
+    if (pass) pass->unhandled = TRUE;
+    pthread_mutex_unlock( &hwheel_lock );
+    return pass != NULL;
+}
+
 static LRESULT default_hwheel( HWND hwnd, WPARAM wparam, LPARAM lparam )
 {
-    struct user_thread_info *info = get_user_thread_info();
-    BOOL outermost = !info->hwheel_depth;
+    struct hwheel_pass pass = {.wparam = wparam, .lparam = lparam}, **ptr;
     LRESULT result = 0;
 
-    if (outermost) info->hwheel_unhandled = FALSE;
     if (get_window_long( hwnd, GWL_STYLE ) & WS_CHILD)
     {
-        info->hwheel_depth++;
-        result = send_message( get_parent( hwnd ), WM_MOUSEHWHEEL, wparam, lparam );
-        info->hwheel_depth--;
-    }
-    else info->hwheel_unhandled = TRUE;
+        pass.to = get_parent( hwnd );
+        pthread_mutex_lock( &hwheel_lock );
+        pass.next = hwheel_passes;
+        hwheel_passes = &pass;
+        pthread_mutex_unlock( &hwheel_lock );
 
-    if (outermost && info->hwheel_unhandled)
-    {
-        info->hwheel_unhandled = FALSE;
-        TRACE( "%p doesn't take the sideways wheel: giving it Shift and the wheel\n", hwnd );
-        result = send_message( hwnd, WM_MOUSEWHEEL,
-                               MAKEWPARAM( GET_KEYSTATE_WPARAM( wparam ) | MK_SHIFT,
-                                           -GET_WHEEL_DELTA_WPARAM( wparam ) ), lparam );
+        result = send_message( pass.to, WM_MOUSEHWHEEL, wparam, lparam );
+
+        pthread_mutex_lock( &hwheel_lock );
+        for (ptr = &hwheel_passes; *ptr != &pass; ptr = &(*ptr)->next) ;
+        *ptr = pass.next;
+        pthread_mutex_unlock( &hwheel_lock );
+        if (!pass.unhandled) return result;
     }
-    return result;
+
+    if (hwheel_passed_on_unhandled( hwnd, wparam, lparam )) return result;
+
+    TRACE( "%p doesn't take the sideways wheel: giving it Shift and the wheel\n", hwnd );
+    return send_message( hwnd, WM_MOUSEWHEEL,
+                         MAKEWPARAM( GET_KEYSTATE_WPARAM( wparam ) | MK_SHIFT,
+                                     -GET_WHEEL_DELTA_WPARAM( wparam ) ), lparam );
 }
 
 LRESULT default_window_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam, BOOL ansi )
diff --git a/dlls/win32u/ntuser_private.h b/dlls/win32u/ntuser_private.h
index f33b53e02f..26bab84b2e 100644
--- a/dlls/win32u/ntuser_private.h
+++ b/dlls/win32u/ntuser_private.h
@@ -132,8 +132,6 @@ struct user_thread_info
     struct mouse_tracking_info   *mouse_tracking_info;    /* NtUserTrackMouseEvent handling */
     struct opengl_thread_data    *opengl_data;            /* OpenGL private thread data */
     struct list                   known_pointers;         /* list of known pointers */
-    WORD                          hwheel_depth;           /* DefWindowProc passing WM_MOUSEHWHEEL to parents */
-    BOOL                          hwheel_unhandled;       /* and no window in the chain took it */
 };
 
 extern struct user_thread_info *get_user_thread_info(void);
-- 
