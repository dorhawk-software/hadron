From 53c456a6a05d07d65f650d33e4ed7aeee53e7a08 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ond=C5=99ej=20=C5=A0imon?= <ondrej@dorhawk.software>
Date: Tue, 17 Nov 2026 10:54:12 +0100
Subject: [PATCH 69/71] win32u, winemac.drv: Clip only a window at the default
 maximize's place, and judge its frame without monitors.

From Hadron's review of 0053 and 0054 (Broyojo/hadron#173):

- get_visible_rect picked the area to clip to from a rule of its own,
  not get_maximized_rect's, and clipped any maximized window. A game
  that strips WS_CAPTION | WS_THICKFRAME, keeps WS_MAXIMIZEBOX and
  maximizes for borderless fullscreen sat over the whole monitor but
  was clipped to the work area, and so was a window whose
  WM_GETMINMAXINFO maximizes it over the whole monitor: the menu bar and
  the Dock showed over the game. Now the two share one rule, and only a
  window within that area and past it by no more than the border
  get_min_max_info gives it is clipped; a window the app placed itself
  is left as it is.
- The driver recomputed the clip, with monitor queries in other
  coordinates, to tell whether the app draws the window's frame; a
  mismatch gave a self-framed window a Mac title bar. It now asks what
  win32u's own rule asks: all client area, shaped, or a style with no
  frame Wine draws.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 dlls/win32u/window.c      | 41 ++++++++++++++++++++-----------
 dlls/winemac.drv/macdrv.h |  2 +-
 dlls/winemac.drv/window.c | 51 +++++++++------------------------------
 3 files changed, 39 insertions(+), 55 deletions(-)

diff --git a/dlls/win32u/window.c b/dlls/win32u/window.c
index 05d66d708e..8f65d15d39 100644
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -2148,15 +2148,26 @@ static RECT get_visible_rect_unclipped( HWND hwnd, BOOL shaped, UINT style, UINT
     return visible_rect;
 }
 
+/* The part of a monitor a maximized window covers: the work area for a window with a caption and a
+ * maximize box, the whole monitor for any other (get_maximized_rect). */
+static RECT get_maximized_area( UINT style, const MONITORINFO *info )
+{
+    if (style & WS_MAXIMIZEBOX && (style & WS_CAPTION) == WS_CAPTION && !(style & WS_CHILD))
+        return info->rcWork;
+    return info->rcMonitor;
+}
+
 /* Windows maximizes a window with a sizing border so that the border hangs past the edges of
- * the work area: off the monitor, or under the taskbar, so the user never sees it. A host window
- * would show it, and the host may move the whole window to keep its top edge on screen (macOS
- * keeps windows below the menu bar), pushing the rest past the other edge. So show a maximized
- * window only where Windows would: within the work area of its monitor, or within the monitor for
- * a window Windows maximizes over the whole monitor (a popup without a caption). */
+ * the area it maximizes over: off the monitor, or under the taskbar, where the user never sees it.
+ * A host window would show it, and the host may move the whole window to keep its top edge on
+ * screen (macOS keeps windows below the menu bar), pushing the rest past the other edge. So show
+ * a window that sits where the default maximize puts it only where Windows does: within that
+ * area. A window the app placed itself, over the whole monitor for one, is left as it is. */
 static RECT get_visible_rect( HWND hwnd, BOOL shaped, UINT style, UINT ex_style, const struct window_rects *rects )
 {
-    RECT visible_rect = get_visible_rect_unclipped( hwnd, shaped, style, ex_style, rects ), area, clipped, dummy;
+    RECT visible_rect = get_visible_rect_unclipped( hwnd, shaped, style, ex_style, rects ), area, clipped, border = {0}, dummy;
+    UINT adjusted_style = (style & WS_CAPTION) == WS_CAPTION ? style & ~WS_BORDER : style;
+    const RECT *window = &rects->window;
     MONITORINFO info;
 
     if (!(style & WS_MAXIMIZE) || (style & WS_CHILD) || get_present_rect( hwnd, &dummy, get_thread_dpi() ))
@@ -2164,10 +2175,15 @@ static RECT get_visible_rect( HWND hwnd, BOOL shaped, UINT style, UINT ex_style,
 
     info = monitor_info_from_rect( rects->window, get_thread_dpi() );
     if (IsRectEmpty( &info.rcMonitor )) return visible_rect;
-    if ((style & WS_MAXIMIZEBOX) && ((style & WS_CAPTION) == WS_CAPTION || !(style & WS_POPUP)))
-        area = info.rcWork;
-    else
-        area = info.rcMonitor;
+    area = get_maximized_area( style, &info );
+
+    /* the frame the default maximize hangs past the area, as get_min_max_info computes it */
+    adjust_window_rect( &border, adjusted_style, (style & WS_POPUP) && get_menu( hwnd ), ex_style, get_system_dpi() );
+    if (window->left > area.left || window->left < area.left + border.left ||
+        window->top > area.top || window->top < area.top + border.top ||
+        window->right < area.right || window->right > area.right + border.right ||
+        window->bottom < area.bottom || window->bottom > area.bottom + border.bottom)
+        return visible_rect;
     if (!intersect_rect( &clipped, &visible_rect, &area )) return visible_rect;
 
     if (!EqualRect( &clipped, &visible_rect ))
@@ -2979,11 +2995,8 @@ static BOOL get_maximized_rect( HWND hwnd, RECT *rect )
     DWORD style;
 
     mon_info = monitor_info_from_window( hwnd, MONITOR_DEFAULTTOPRIMARY );
-    *rect = mon_info.rcMonitor;
-
     style = get_window_long( hwnd, GWL_STYLE );
-    if (style & WS_MAXIMIZEBOX && (style & WS_CAPTION) == WS_CAPTION && !(style & WS_CHILD))
-        *rect = mon_info.rcWork;
+    *rect = get_maximized_area( style, &mon_info );
     return TRUE;
 }
 
diff --git a/dlls/winemac.drv/macdrv.h b/dlls/winemac.drv/macdrv.h
index 2389d70e94..b83081591c 100644
--- a/dlls/winemac.drv/macdrv.h
+++ b/dlls/winemac.drv/macdrv.h
@@ -238,7 +238,7 @@ extern BOOL macdrv_SystemParametersInfo(UINT action, UINT int_param, void *ptr_p
     unsigned int        per_pixel_alpha : 1;    /* is window using per-pixel alpha? */
     unsigned int        minimized : 1;          /* is window minimized? */
     unsigned int        fullscreen : 1;         /* is the window visible rect fullscreen? (unrelated to native AppKit/Cocoa fullscreen) */
-    unsigned int        own_frame : 1;          /* does the app draw the window's whole frame (its visible rect is all of the window)? */
+    unsigned int        own_frame : 1;          /* does the app draw the window's whole frame (draws_own_frame)? */
     unsigned int        frame_gesture : 1;      /* is something on the Mac side changing the maximized window's frame? */
     RECT                gesture_start;          /* the window's visible rect when that began, raw pixels */
 };
diff --git a/dlls/winemac.drv/window.c b/dlls/winemac.drv/window.c
index dd23cdd49c..e234cf04b0 100644
--- a/dlls/winemac.drv/window.c
+++ b/dlls/winemac.drv/window.c
@@ -104,52 +104,24 @@ static BOOL region_covers_window(HWND hwnd)
 }
 
 
-/***********************************************************************
- *              maximized_area
- *
- * The part of a monitor that a maximized window shows in: the work area, or the whole monitor for
- * a popup without a caption (win32u's get_visible_rect).
- */
-static RECT maximized_area(UINT style, const MONITORINFO *info)
-{
-    if ((style & WS_MAXIMIZEBOX) && ((style & WS_CAPTION) == WS_CAPTION || !(style & WS_POPUP)))
-        return info->rcWork;
-    return info->rcMonitor;
-}
-
-
 /***********************************************************************
  *              draws_own_frame
  *
- * Whether the app draws the window's whole frame: win32u leaves the visible rect the whole window
- * rect. A maximized window shows only within the work area of its monitor (or the monitor, for a
- * popup without a caption), so for one, the visible rect is the window rect clipped to that.
- * The window's style and rects are the new ones; call it without the window data locked.
+ * Whether the app draws the window's whole frame, so Wine draws none: win32u then leaves the
+ * visible rect the whole window rect. A maximized window at the default maximize's place shows
+ * only within the area it maximizes over (win32u's get_visible_rect), so for one, the reasons
+ * win32u has are asked instead: the window is all client area, it's shaped, or its style has no
+ * frame Wine draws.
  */
-static BOOL draws_own_frame(UINT style, const struct window_rects *rects)
+static BOOL draws_own_frame(UINT style, UINT ex_style, BOOL shaped, const struct window_rects *rects)
 {
-    MONITORINFO info = {.cbSize = sizeof(info)};
-    HMONITOR monitor;
-    RECT area, clipped;
-    UINT context;
-    BOOL ret = FALSE;
+    struct macdrv_window_features wf;
 
     if (EqualRect(&rects->window, &rects->visible)) return TRUE;
     if (!(style & WS_MAXIMIZE) || (style & WS_CHILD)) return FALSE;
-
-    context = NtUserSetThreadDpiAwarenessContext(NTUSER_DPI_PER_MONITOR_AWARE_V2);
-    if ((monitor = NtUserMonitorFromRect(&rects->window, MONITOR_DEFAULTTONEAREST)) &&
-        NtUserGetMonitorInfo(monitor, &info))
-    {
-        area = maximized_area(style, &info);
-        clipped.left = max(rects->window.left, area.left);
-        clipped.top = max(rects->window.top, area.top);
-        clipped.right = min(rects->window.right, area.right);
-        clipped.bottom = min(rects->window.bottom, area.bottom);
-        ret = EqualRect(&clipped, &rects->visible);
-    }
-    NtUserSetThreadDpiAwarenessContext(context);
-    return ret;
+    if (EqualRect(&rects->window, &rects->client) || shaped) return TRUE;
+    wf = get_window_features_for_style(style, ex_style, FALSE);
+    return !wf.title_bar && !wf.shadow;
 }
 
 
@@ -1726,7 +1698,6 @@ void macdrv_WindowPosChanged(HWND hwnd, HWND insert_after, HWND owner_hint, UINT
     struct macdrv_win_data *data;
     unsigned int new_style = NtUserGetWindowLongW(hwnd, GWL_STYLE);
     struct window_rects old_rects;
-    BOOL own_frame = draws_own_frame(new_style, new_rects);
 
     if (!(data = get_win_data(hwnd))) return;
 
@@ -1734,7 +1705,7 @@ void macdrv_WindowPosChanged(HWND hwnd, HWND insert_after, HWND owner_hint, UINT
 
     old_rects = data->rects;
     data->rects = *new_rects;
-    data->own_frame = own_frame;
+    data->own_frame = draws_own_frame(new_style, NtUserGetWindowLongW(hwnd, GWL_EXSTYLE), data->shaped, new_rects);
     if (!(new_style & WS_MAXIMIZE))
     {
         data->frame_gesture = FALSE;
-- 
